<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="8dp"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/live_team_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/ui_background"
        app:cardCornerRadius="28dp"
        android:layout_marginBottom="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Match name / series at top -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/secondary_text"
                android:textSize="14sp"
                android:id="@+id/live_series_tv"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_margin="16dp"
                tools:text="Match 1 • Series 2025" />

            <!-- NSC team score row -->
            <androidx.cardview.widget.CardView
                android:id="@+id/live_card_team1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/bar_ui"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/live_series_tv">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/live_team1_image"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/nsc_logo"
                        android:layout_marginLeft="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/live_team1_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="6dp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="?attr/screen_background"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/live_team1_image"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="NSC" />

                    <TextView
                        android:id="@+id/live_team1_score"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="8dp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="?attr/screen_background"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="85/3 (10.0)" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- NSC top batter -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="22dp"
                android:id="@+id/live_top_team1_iv"
                android:layout_height="22dp"
                android:layout_marginLeft="22dp"
                android:src="@drawable/default_pic"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/live_card_team1"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/live_top_team1_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top_team1_iv"
                app:layout_constraintLeft_toRightOf="@id/live_top_team1_iv"
                app:layout_constraintBottom_toBottomOf="@id/live_top_team1_iv"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/live_top_team1_score"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="22dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top_team1_iv"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/live_top_team1_iv"
                tools:text="35* (20)" />

            <!-- NSC top bowler -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="22dp"
                android:id="@+id/live_top2_team1_iv"
                android:layout_height="22dp"
                android:layout_marginLeft="22dp"
                android:src="@drawable/default_pic"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/live_top_team1_iv"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/live_top2_team1_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top2_team1_iv"
                app:layout_constraintLeft_toRightOf="@id/live_top2_team1_iv"
                app:layout_constraintBottom_toBottomOf="@id/live_top2_team1_iv"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/live_top2_team1_score"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="22dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top2_team1_iv"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/live_top2_team1_iv"
                tools:text="2-18" />

            <!-- SBR team score row -->
            <androidx.cardview.widget.CardView
                android:id="@+id/live_card_team2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/bar_ui"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/live_top2_team1_iv">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/live_team2_image"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/sbr_logo"
                        android:layout_marginLeft="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/live_team2_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="6dp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="?attr/screen_background"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/live_team2_image"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="SBR" />

                    <TextView
                        android:id="@+id/live_team2_score"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="8dp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="?attr/screen_background"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="-" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- SBR top batter -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="22dp"
                android:id="@+id/live_top_team2_iv"
                android:layout_height="22dp"
                android:layout_marginLeft="22dp"
                android:src="@drawable/default_pic"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/live_card_team2"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/live_top_team2_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top_team2_iv"
                app:layout_constraintLeft_toRightOf="@id/live_top_team2_iv"
                app:layout_constraintBottom_toBottomOf="@id/live_top_team2_iv"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/live_top_team2_score"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="22dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top_team2_iv"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/live_top_team2_iv"
                tools:text="40* (25)" />

            <!-- SBR top bowler -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="22dp"
                android:id="@+id/live_top2_team2_iv"
                android:layout_height="22dp"
                android:layout_marginLeft="22dp"
                android:src="@drawable/default_pic"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/live_top_team2_iv"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/live_top2_team2_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top2_team2_iv"
                app:layout_constraintLeft_toRightOf="@id/live_top2_team2_iv"
                app:layout_constraintBottom_toBottomOf="@id/live_top2_team2_iv"
                tools:text="Player Name" />

            <TextView
                android:id="@+id/live_top2_team2_score"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="22dp"
                android:textColor="?attr/main_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/live_top2_team2_iv"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/live_top2_team2_iv"
                tools:text="3-20" />

            <!-- Bottom status: LIVE badge + innings / target info -->
            <TextView
                android:id="@+id/live_status_tv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:textColor="?attr/button_background"
                app:layout_constraintHorizontal_bias="0"
                android:layout_marginLeft="16dp"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/live_top2_team2_iv"
                tools:text="● LIVE  |  1st Innings" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Ripple overlay for click -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/live_card_click"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:strokeColor="#00ffffff"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#00ffffff"
        app:rippleColor="?attr/bar_background"
        app:layout_constraintTop_toTopOf="@id/live_team_card"
        app:layout_constraintLeft_toLeftOf="@id/live_team_card"
        app:layout_constraintRight_toRightOf="@id/live_team_card"
        app:layout_constraintBottom_toBottomOf="@id/live_team_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
